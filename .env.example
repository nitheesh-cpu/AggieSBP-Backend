# Database and existing application settings belong here as needed.

# TAMU AI Chat (copy the endpoint and model identifier from the TAMU API page)
TAMU_AI_API_KEY=
TAMU_AI_BASE_URL=https://chat-api.tamu.ai/openai
TAMU_AI_MODEL=
TAMU_AI_TIMEOUT_SECONDS=90
TAMU_AI_MAX_INPUT_CHARS=45000
# Safety limits for one scheduled run. Zero means unlimited.
TAMU_AI_MAX_REQUESTS_PER_RUN=0
TAMU_AI_MAX_SUMMARIES_PER_RUN=0

# TypeSafe System One / Jev
TYPESAFE_API_KEY=
TYPESAFE_SUPPORT_THRESHOLD=0.72
