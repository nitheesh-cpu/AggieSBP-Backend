# Database and existing application settings belong here as needed.

# TAMU AI Chat (copy the endpoint and model identifier from the TAMU API page)
TAMU_AI_API_KEY=
TAMU_AI_BASE_URL=https://chat-api.tamu.ai/openai
TAMU_AI_MODEL=
TAMU_AI_TIMEOUT_SECONDS=90
# One request per professor; larger inputs split by whole course groups.
TAMU_AI_MAX_INPUT_CHARS=45000
# Base output budget per request (+500 per extra course group, max 8000).
TAMU_AI_MAX_OUTPUT_TOKENS=2400
# Each review is clipped to this many characters in the prompt.
SUMMARY_REVIEW_CLIP_CHARS=600
SUMMARY_MAX_COURSES_PER_REQUEST=8
# Strict generation plus local Pydantic validation. json_object is an explicit
# compatibility option for models without strict-schema support.
TAMU_AI_RESPONSE_FORMAT=json_schema
# Retries for temporary server/connection failures (in addition to first attempt).
TAMU_AI_MAX_RETRIES=2
# Global API concurrency across professors in each batch; maximum 4.
SUMMARY_API_WORKERS=4
SUMMARY_MIN_NEW_REVIEW_PERCENT=10
# Safety limits for one scheduled run. Zero means unlimited.
TAMU_AI_MAX_REQUESTS_PER_RUN=0
TAMU_AI_MAX_SUMMARIES_PER_RUN=0

# TypeSafe System One / Jev. Optional: set TYPESAFE_VERIFY=1 to check that each
# claim is supported by its cited reviews. Only support below the threshold
# rejects a claim; the topic/risk thresholds apply to the local BART path.
TYPESAFE_VERIFY=0
TYPESAFE_API_KEY=
TYPESAFE_SUPPORT_THRESHOLD=0.72
TYPESAFE_TOPIC_THRESHOLD=0.62
TYPESAFE_RISK_THRESHOLD=0.55
# Conservative serialized UTF-8 byte budgets (not tokenizer counts).
TYPESAFE_MAX_STATE_BYTES=24000
TYPESAFE_MAX_REQUEST_BYTES=48000
